# ─────────────────────────────────────────────
# Deal Haven — Environment Variables
# Copy to .env and fill in actual values
# ─────────────────────────────────────────────

# App
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info
LOG_QUERIES=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/deal_haven_dev"
DATABASE_URL_TEST="postgresql://postgres:password@localhost:5432/deal_haven_test"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication (generate with: openssl rand -base64 64)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-chars
COOKIE_SECRET=your-super-secret-cookie-key-minimum-32-chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# File Storage
UPLOAD_DIR=uploads
# For S3 (when ready to migrate):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=deal-haven-uploads
# AWS_REGION=us-east-1

# Email (development: use Ethereal or Mailtrap)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-ethereal-user
SMTP_PASS=your-ethereal-password
EMAIL_FROM="Deal Haven <noreply@dealhaven.com>"
EMAIL_REPLY_TO=support@dealhaven.com

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Maps (frontend)
NEXT_PUBLIC_MAPBOX_TOKEN=
# Or Leaflet (no key needed for OpenStreetMap)

# Frontend-specific (Next.js public env vars)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
