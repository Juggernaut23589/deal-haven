# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

# --- OCI authentication (from OCI Console: Profile -> User Settings -> API Keys) ---
tenancy_ocid     = "ocid1.tenancy.oc1..xxxxx"
user_ocid        = "ocid1.user.oc1..xxxxx"
fingerprint      = "aa:bb:cc:dd:ee:ff:..."
private_key_path = "~/.oci/oci_api_key.pem"
region           = "eu-frankfurt-1"

# Compartment to create resources in. Root tenancy OCID is fine for a personal project.
compartment_ocid = "ocid1.tenancy.oc1..xxxxx"

# --- SSH key that will be installed on the VM ---
ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# --- Optional overrides ---
# project_name        = "ashimarket"
# environment         = "staging"
# ssh_ingress_cidr    = "YOUR.PUBLIC.IP.HERE/32"   # restrict SSH to your IP
# instance_ocpus      = 4
# instance_memory_gb  = 24
# boot_volume_size_gb = 100
