# Ashimarket — App Environment
NODE_ENV=production

# Backend
API_PORT={{ api_port }}
DATABASE_URL=postgresql://{{ db_user }}:{{ db_password }}@{{ db_private_ip }}:{{ db_port }}/{{ db_name }}
REDIS_URL=redis://{{ redis_private_ip }}:{{ redis_port }}
REDIS_HOST={{ redis_private_ip }}
REDIS_PORT={{ redis_port }}
REDIS_PASSWORD=
REDIS_DB=0

# Frontend
NEXT_PUBLIC_API_URL=https://{{ domain_name }}/api/v1
API_URL=https://{{ domain_name }}
FRONTEND_URL=https://{{ domain_name }}
ALLOWED_ORIGINS=https://{{ domain_name }},https://www.{{ domain_name }}

# Auth
JWT_SECRET={{ jwt_secret | default('changeme_use_ansible_vault') }}
JWT_REFRESH_SECRET={{ jwt_refresh_secret | default(jwt_secret | default('changeme_refresh_secret')) }}
COOKIE_SECRET={{ cookie_secret | default(jwt_secret | default('changeme_cookie_secret')) }}
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Google OAuth
GOOGLE_CLIENT_ID={{ google_client_id }}
GOOGLE_CLIENT_SECRET={{ google_client_secret }}
GOOGLE_CALLBACK_URL=https://{{ domain_name }}/api/v1/auth/google/callback
