# Ashimarket — production .env template
#
# Copy to /home/deploy/ashimarket/.env on the server (never commit the real
# file). deploy.yml copies this into backend/.env on every deploy.
#
# NOTE: the backend reads `process.env.PORT` (src/index.ts) — do not rename
# this to API_PORT. The old Ansible template did, which silently meant the
# backend always ran on its hardcoded fallback (4000) rather than any value
# actually set here; harmless only because the fallback matched by luck.

NODE_ENV=production
PORT=4000
HOST=0.0.0.0
API_URL=https://ashimarket.com
FRONTEND_URL=https://ashimarket.com
NEXT_PUBLIC_API_URL=https://ashimarket.com/api/v1
ALLOWED_ORIGINS=https://ashimarket.com,https://www.ashimarket.com
LOG_LEVEL=info
LOG_QUERIES=false

UPLOAD_DIR=/home/deploy/ashimarket/backend/uploads

# Postgres + Redis run on this same box now — always localhost.
DATABASE_URL=postgresql://ashimarket_app:<db-password>@127.0.0.1:5432/ashimarket
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Generate each with: openssl rand -base64 64
JWT_SECRET=<generate>
JWT_REFRESH_SECRET=<generate>
COOKIE_SECRET=<generate>
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Google OAuth
GOOGLE_CLIENT_ID=<from Google Cloud Console>
GOOGLE_CLIENT_SECRET=<from Google Cloud Console>
GOOGLE_CALLBACK_URL=https://ashimarket.com/api/v1/auth/google/callback
